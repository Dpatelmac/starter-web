//@version=6
// <Strategy name>: one-line idea.
// Chart: SPY, <timeframe>. Long only / long + short.
strategy("SPY <Strategy name>", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 1)

// ---- Inputs ----
len       = input.int(20, "Length", minval = 1)
startDate = input.time(timestamp("2000-01-01T00:00:00"), "Start date")

// ---- Calculations (keep ta.* calls at the top level, not inside if blocks) ----
inRange = time >= startDate
ma      = ta.sma(close, len)
longIn  = ta.crossover(close, ma)
longOut = ta.crossunder(close, ma)

// ---- Orders ----
if inRange and longIn
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")

// ---- Plots ----
plot(ma, "MA", color = color.blue)
