//@version=6
// Bollinger Band reversion: buy a close below the lower band while above the long-term trend,
// sell back at the middle band.
// Chart: SPY, 1D (also try 4H). Long only.
strategy("SPY Bollinger Band Reversion", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 1)

bbLen     = input.int(20, "BB length", minval = 2)
bbMult    = input.float(2.0, "BB std dev", minval = 0.5, step = 0.1)
trendLen  = input.int(200, "Trend filter SMA (0 = off)", minval = 0)
stopPct   = input.float(0, "Stop loss % (0 = off)", minval = 0, step = 0.5)
startDate = input.time(timestamp("2000-01-01T00:00:00"), "Start date")

inRange = time >= startDate
[mid, upper, lower] = ta.bb(close, bbLen, bbMult)
trendMA = ta.sma(close, math.max(trendLen, 2))
trend   = trendLen > 0 ? trendMA : na
trendOk = trendLen == 0 or close > trend

if inRange and strategy.position_size == 0 and close < lower and trendOk
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    if close > mid
        strategy.close("Long", comment = "Mid band")
    else if stopPct > 0
        strategy.exit("Stop", "Long", stop = strategy.position_avg_price * (1 - stopPct / 100))

plot(mid, "Middle", color = color.gray)
pU = plot(upper, "Upper", color = color.teal)
pL = plot(lower, "Lower", color = color.teal)
fill(pU, pL, color = color.new(color.teal, 92))
plot(trend, "Trend SMA", color = color.blue, linewidth = 2)
