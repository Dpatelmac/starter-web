//@version=6
// Supertrend: follow the ATR-based trend line. Long when it flips up, exit (or reverse) when it flips down.
// Chart: SPY, 1H / 4H / 1D.
strategy("SPY Supertrend", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 1)

atrLen     = input.int(10, "ATR length", minval = 1)
factor     = input.float(3.0, "Factor", minval = 0.5, step = 0.5)
allowShort = input.bool(false, "Allow shorts")
startDate  = input.time(timestamp("2000-01-01T00:00:00"), "Start date")

inRange = time >= startDate
[st, dir] = ta.supertrend(factor, atrLen)
// dir < 0 means uptrend, dir > 0 means downtrend
flipUp = dir < 0 and dir[1] > 0
flipDn = dir > 0 and dir[1] < 0

// strategy.entry reverses an open position, so a flip closes the old side and opens the new one.
if inRange and flipUp
    strategy.entry("Long", strategy.long)
if flipDn
    if allowShort and inRange
        strategy.entry("Short", strategy.short)
    else
        strategy.close("Long", comment = "Flip down")

plot(st, "Supertrend", color = dir < 0 ? color.green : color.red, linewidth = 2, style = plot.style_linebr)
