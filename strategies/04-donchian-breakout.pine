//@version=6
// Donchian channel breakout (Turtle style): buy a close above the prior N-bar high,
// exit on a close below the prior M-bar low.
// Chart: SPY, 1D (also try 4H / 1H). Long only by default.
strategy("SPY Donchian Breakout", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 1)

entryLen   = input.int(20, "Entry channel (bars)", minval = 2)
exitLen    = input.int(10, "Exit channel (bars)", minval = 2)
allowShort = input.bool(false, "Allow shorts")
startDate  = input.time(timestamp("2000-01-01T00:00:00"), "Start date")

inRange   = time >= startDate
entryHigh = ta.highest(high, entryLen)[1]
entryLow  = ta.lowest(low, entryLen)[1]
exitLow   = ta.lowest(low, exitLen)[1]
exitHigh  = ta.highest(high, exitLen)[1]

if inRange and close > entryHigh
    strategy.entry("Long", strategy.long)
if inRange and allowShort and close < entryLow
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and close < exitLow
    strategy.close("Long", comment = "Exit channel")
if strategy.position_size < 0 and close > exitHigh
    strategy.close("Short", comment = "Exit channel")

plot(entryHigh, "Entry high", color = color.green)
plot(entryLow, "Entry low", color = color.red)
plot(exitLow, "Exit low", color = color.new(color.green, 60), style = plot.style_stepline)
