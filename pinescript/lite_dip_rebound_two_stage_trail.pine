// Flowchart -> Strategy: Dip / Rebound entry with a two-stage trailing stop (long & flat only)
//@version=6
strategy("Demo GPT - LITE Dip Rebound Two-Stage Trailing Stop", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0)

// ──────────────────────────────── Inputs ────────────────────────────────
dipAmt     = input.float(60.0, "Dip from Highest Price ($)",        minval=0.01, step=1.0, group="Entry")
reboundPct = input.float(0.5,  "Rebound from Lowest Price (%)",     minval=0.0,  step=0.1, group="Entry")
wideTrail  = input.float(95.0, "Initial Trailing Stop ($)",         minval=0.01, step=1.0, group="Exit")
targetAmt  = input.float(60.0, "Profit Target above Buy Price ($)", minval=0.01, step=1.0, group="Exit")
tightTrail = input.float(10.0, "Tight Trailing Stop ($)",           minval=0.01, step=1.0, group="Exit")

startDate  = input.time(timestamp("01 Jan 2018 00:00 +0000"), "Start Date", group="Date Range")
endDate    = input.time(timestamp("31 Dec 2069 23:59 +0000"), "End Date",   group="Date Range")

// ──────────────────────────────── States ────────────────────────────────
// 0 = FLAT, tracking the highest price
// 1 = Dip found, tracking the lowest price
// 2 = Long, $95 trailing stop active (also watching for the +$60 profit target)
// 3 = Long, $10 trailing stop active (profit target reached)
int ST_TRACK_HIGH = 0
int ST_TRACK_LOW  = 1
int ST_LONG_WIDE  = 2
int ST_LONG_TIGHT = 3

var int   state     = ST_TRACK_HIGH
var float trackHigh = na
var float trackLow  = na
var float buyPrice  = na
var float trailHigh = na
var float stopLevel = na

inWindow = time >= startDate and time <= endDate
inPos    = strategy.position_size > 0
justSold = strategy.closedtrades > strategy.closedtrades[1]

bool dipFound   = false
bool targetHit  = false
bool skipBar    = false

// ─────────────────── Back to FLAT after every sale (high resets) ───────────────────
if justSold and not inPos
    state     := ST_TRACK_HIGH
    trackHigh := close
    trackLow  := na
    buyPrice  := na
    trailHigh := na
    stopLevel := na
    skipBar   := true

// ─────────────────── Outside the date range: no trading, start fresh ───────────────────
if not inWindow
    if inPos
        strategy.close("Long", comment="Date range end")
    else
        state     := ST_TRACK_HIGH
        trackHigh := na
        trackLow  := na
        buyPrice  := na
        trailHigh := na
        stopLevel := na

// ──────────────────────────────── State machine ────────────────────────────────
if inWindow and not skipBar
    // Track the highest price -> dip found?
    if state == ST_TRACK_HIGH
        trackHigh := na(trackHigh) ? high : math.max(trackHigh, high)
        if low <= trackHigh - dipAmt
            state    := ST_TRACK_LOW
            trackLow := low
            dipFound := true
    // Track the lowest price after the drop
    else if state == ST_TRACK_LOW
        trackLow := math.min(trackLow, low)

    // Rebound? -> BUY (100% of equity) and place the $95 trailing stop
    if state == ST_TRACK_LOW and close >= trackLow * (1 + reboundPct / 100)
        strategy.entry("Long", strategy.long, comment="Buy (rebound)")
        state     := ST_LONG_WIDE
        buyPrice  := na
        trailHigh := close
        stopLevel := close - wideTrail
    // In position: monitor BOTH the trailing stop and the profit target
    else if (state == ST_LONG_WIDE or state == ST_LONG_TIGHT) and inPos
        bool firstBar = na(buyPrice)
        if firstBar
            buyPrice := strategy.position_avg_price
        if state == ST_LONG_WIDE and high >= buyPrice + targetAmt
            // Profit target hit: cancel the $95 stop, start the $10 trail from here
            state     := ST_LONG_TIGHT
            trailHigh := high
            targetHit := true
        else
            trailHigh := firstBar ? high : math.max(trailHigh, high)
        stopLevel := trailHigh - (state == ST_LONG_TIGHT ? tightTrail : wideTrail)

    // One exit order whose stop is replaced each bar (only one stop is ever active)
    if state == ST_LONG_WIDE or state == ST_LONG_TIGHT
        strategy.exit("Exit", "Long", stop=stopLevel, comment=state == ST_LONG_TIGHT ? "Sold - profit ($10 trail)" : "Sold - stop ($95 trail)")

// ──────────────────────────────── Visuals ────────────────────────────────
isTrackHigh = state == ST_TRACK_HIGH
isTrackLow  = state == ST_TRACK_LOW
isWide      = state == ST_LONG_WIDE
isTight     = state == ST_LONG_TIGHT

plot(isTrackHigh ? trackHigh : na,                         "Highest Price",       color=color.new(color.gray, 0),    style=plot.style_linebr, linewidth=1)
plot(isTrackHigh ? trackHigh - dipAmt : na,                "Dip Level (High - $)", color=color.new(color.orange, 0), style=plot.style_linebr, linewidth=1)
plot(isTrackLow ? trackLow : na,                           "Lowest Price",        color=color.new(color.teal, 0),    style=plot.style_linebr, linewidth=1)
plot(isTrackLow ? trackLow * (1 + reboundPct / 100) : na,  "Rebound Level",       color=color.new(color.lime, 0),    style=plot.style_linebr, linewidth=1)
plot((isWide or isTight) ? buyPrice : na,                  "Buy Price",           color=color.new(color.blue, 0),    style=plot.style_linebr, linewidth=1)
plot(isWide ? buyPrice + targetAmt : na,                   "Profit Target",       color=color.new(color.green, 0),   style=plot.style_linebr, linewidth=1)
plot(isWide ? stopLevel : na,                              "$95 Trailing Stop",   color=color.new(color.red, 0),     style=plot.style_linebr, linewidth=2)
plot(isTight ? stopLevel : na,                             "$10 Trailing Stop",   color=color.new(color.orange, 0),  style=plot.style_linebr, linewidth=2)

plotshape(dipFound,  "Dip Found",          shape.triangledown, location.belowbar, color.new(color.orange, 0), size=size.tiny, text="Dip")
plotshape(targetHit, "Profit Target Hit",  shape.diamond,      location.abovebar, color.new(color.green, 0),  size=size.tiny, text="+Target")
bgcolor(isWide ? color.new(color.red, 92) : isTight ? color.new(color.green, 92) : na, title="Position Phase")
